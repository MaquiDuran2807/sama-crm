# =============================================================================
# SAMA AdTech — Variables de Entorno
# =============================================================================
# Copiar a .env y ajustar según entorno.
# Para desarrollo: cp .env.example .env
# Para producción: exportar o usar docker-compose.prod.yml

# --- Django -----------------------------------------------------------------
DEBUG=True
SECRET_KEY=dev-only-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# --- Base de datos ----------------------------------------------------------
# Desarrollo (SQLite):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Producción (PostgreSQL) — descomentar:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sama_prod
# DB_USER=sama
# DB_PASSWORD=<generar password seguro>
# DB_HOST=localhost
# DB_PORT=5432

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Evolution API ----------------------------------------------------------
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCES_ENDPOINT=/instance/fetchInstances
EVOLUTION_MESSAGES_ENDPOINT=/message/findMessages
EVOLUTION_SYNC_OVERLAP_HOURS=6
EVOLUTION_STOP_AFTER_STALE_PAGES=2

# --- Ollama / IA ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_SUMMARY_TIMEOUT_SECONDS=90
AI_SUMMARY_SCHEDULER_ENABLED=True
AI_SUMMARY_STARTUP_LOOKBACK_HOURS=48
AI_SUMMARY_CHECK_INTERVAL_SECONDS=300

# --- Audio Briefing (Piper-TTS) ---------------------------------------------
PIPER_VOICE_MODEL=es_ES-davefx-medium
PIPER_VOICE_FALLBACKS=es_ES-davefx-medium,es_MX-claude-high,es_MX-ald-medium
PIPER_USE_GPU=True
PIPER_GPU_DEVICE=0
AUTO_SEND_BRIEFING_AUDIO=False
AUDIO_BRIEFING_ENABLED=True
AUDIO_BRIEFING_MAX_CLIENTS=20
AUDIO_BRIEFING_MAX_SUMMARY_CHARS=380
AUDIO_BRIEFING_MAX_SAMPLE_CHARS=160
AUDIO_BRIEFING_MAX_TOTAL_CHARS=12000
AUDIO_BRIEFING_TTS_SPEED=0.7

# --- Webhook ----------------------------------------------------------------
WEBHOOK_SECRET=change-me-in-env

# --- Throttling -------------------------------------------------------------
THROTTLE_ANON_RATE=10/minute
THROTTLE_USER_RATE=100/minute

# --- Seguridad HTTPS (producción) -------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
