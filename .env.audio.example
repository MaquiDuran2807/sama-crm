# ==========================================
# Audio Briefing + Piper-TTS Configuration
# ==========================================

# Modelo de voz Piper para español
# Opciones verificadas: es_ES-davefx-medium, es_MX-claude-high, es_MX-ald-medium
PIPER_VOICE_MODEL=es_ES-davefx-medium
PIPER_VOICE_FALLBACKS=es_ES-davefx-medium,es_MX-claude-high,es_MX-ald-medium

# Usar GPU si está disponible (CUDA)
# Para GTX 1050 Ti (4GB VRAM): True
PIPER_USE_GPU=True

# Índice del dispositivo GPU (0 = default, la primera)
PIPER_GPU_DEVICE=0

# Enviar automáticamente por Evolution API
# False = guardar solo en BD, no enviar
AUTO_SEND_BRIEFING_AUDIO=False

# Activar generador de briefings de audio
AUDIO_BRIEFING_ENABLED=True

# Velocidad de voz (1.0 normal, <1 más lento, >1 más rápido)
AUDIO_BRIEFING_TTS_SPEED=0.7

# Límite de clientes y tamaño del briefing (puedes subirlos si solo ejecutas una vez al día)
AUDIO_BRIEFING_MAX_CLIENTS=20
AUDIO_BRIEFING_MAX_TOTAL_CHARS=12000
